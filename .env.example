# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# --- PostgreSQL (local dev, provisioned via dnf, PG16 + pgvector) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=kb_fabric
POSTGRES_USER=kb_fabric
POSTGRES_PASSWORD=changeme
# Full DSN, convenience form (used directly by SQLAlchemy/psycopg):
DATABASE_URL=postgresql://kb_fabric:changeme@127.0.0.1:5432/kb_fabric

# --- Redis (local dev, provisioned via dnf) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# --- LLM access (Landmark LiteLLM proxy) ---
LITELLM_BASE_URL=https://lmlitellm.landmarkgroup.com
LITELLM_API_KEY=changeme
CHAT_MODEL=gpt-5.5
EMBEDDING_MODEL=landmark-text-embedding-3-large

# --- Local data paths ---
RAW_DOCS_DIR=./data/raw
PROCESSED_DIR=./data/processed
